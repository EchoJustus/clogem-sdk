{:min-bb-version "1.13.225"
 :paths ["src" "test" "resources"]
 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.string :as str]
             [clojure.test :as t])

  test
  {:doc "Run clojure.test over test/**/*_test.clj."
   :task (let [files (if (fs/exists? "test") (fs/glob "test" "**_test.clj") [])
               ns-of (fn [f] (-> (str (fs/relativize "test" f))
                                 (str/replace (re-pattern "\\.clj$") "")
                                 (str/replace "/" ".")
                                 (str/replace "_" "-")
                                 symbol))
               nss (sort (map ns-of files))]
           (if (empty? nss)
             (println "test: no test namespaces found")
             (do (apply require nss)
                 (let [{:keys [fail error]} (apply t/run-tests nss)]
                   (when (pos? (+ fail error)) (System/exit 1))))))}

  lint
  {:doc "Fitness checks: license headers (S00); ownership and isolation rules from S01."
   :requires ([clogem.sdk.lint :as lint])
   :task (when-not (lint/lint! {:root "." :license :apache-2.0})
           (System/exit 1))}

  manifest:check
  {:doc "Validate a manifest.edn against the meta-schema (clogem.sdk.manifest, S01)."
   :task (do (binding [*out* *err*]
               (println "manifest:check: clogem.sdk.manifest is scheduled for S01"))
             (System/exit 2))}

  guard:public
  {:doc "Leak guard: workspace denylist, home paths, tokens, private files. Tree and history; --staged scans the index only (pre-commit)."
   :requires ([clogem.sdk.guard :as guard])
   :task (let [staged? (boolean (some #{"--staged"} *command-line-args*))]
           (when-not (guard/guard! {:root "." :staged? staged? :history? (not staged?)})
             (System/exit 1)))}

  guard:message
  {:doc "Leak guard over a commit message file (commit-msg hook): bb guard:message <file>."
   :requires ([clogem.sdk.guard :as guard])
   :task (when-not (guard/guard-message! {:root "." :file (first *command-line-args*)})
           (System/exit 1))}

  hooks:install
  {:doc "Install pre-commit (guard:public --staged) and commit-msg (guard:message) hooks in git's hooks directory."
   :task (let [dir (-> (p/shell {:out :string} "git" "rev-parse" "--git-path" "hooks")
                       :out str/trim fs/path)
               write! (fn [name body]
                        (let [hook (fs/path dir name)]
                          (fs/create-dirs dir)
                          (spit (str hook) body)
                          (fs/set-posix-file-permissions hook "rwxr-xr-x")
                          (println (str "hooks:install: wrote " hook))))
               banner (str "#!/bin/sh\n"
                           "# Installed by `bb hooks:install`: blocks commits that would leak\n"
                           "# private names, home paths or tokens into this public repository.\n"
                           "cd \"$(git rev-parse --show-toplevel)\" || exit 1\n")]
           (write! "pre-commit" (str banner "exec bb guard:public --staged\n"))
           (write! "commit-msg" (str banner "exec bb guard:message \"$1\"\n")))}}}

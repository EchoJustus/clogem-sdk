;; The fictional `echo` module: the smallest complete manifest, used by the
;; SDK's tests and docs and by the hub's registry tests.
{:manifest/version 1
 :module/id :echo
 :module/version "0.1.0"
 :module/license :apache-2.0
 :module/description "Fictional example module that echoes a message back."
 :module/entry clogem.module.echo.core/module
 :module/requires {:clogem/api "1" :bins [] :env #{}}
 :bus {:publishes {:echo/said [:map [:text :string]]
                   ;; the hub turns this into notifications/resources/updated
                   :resource/updated [:map {:closed true} [:uri :string]]}
       :subscribes #{}}
 :db {:migrations nil}
 :mcp {:tools [{:name "echo_say"
                :title "Echo"
                :description "Echo a message back, optionally upper-cased. Use it to check that a module round-trips through the hub."
                :handler clogem.module.echo.tools/say
                :input [:map {:closed true}
                        [:text [:string {:min 1 :max 1000}]]
                        [:upcase {:optional true} :boolean]]
                :output [:map [:text :string]]
                :annotations {:readOnlyHint true :idempotentHint true}
                :meta {}
                :profiles #{:gui :llm-small :llm-large :admin}}]
       :resources [{:uri "clogem://echo/last/said"
                    :name "last-said"
                    :title "Last echoed text"
                    :description "The text of the most recent echo_say call, or an empty string."
                    :mime-type "text/plain"
                    :handler clogem.module.echo.resources/last-said
                    :profiles #{:gui :llm-small :llm-large :admin}}]
       :resource-templates [{:uri-template "clogem://echo/history/{n}"
                             :name "history"
                             :title "Echo history"
                             :description "The n-th echoed text (0 is the oldest)."
                             :mime-type "text/plain"
                             :handler clogem.module.echo.resources/history
                             :profiles #{:gui :llm-large :admin}}]
       :prompts []}
 :ui {:card {:title "Echo" :icon "chat" :quick-actions ["echo_say"]}
      :routes []}}
